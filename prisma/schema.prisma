generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   Profile?
}

model Profile {
  id                   String        @id @default(cuid())
  address              String?
  phoneNumber          String?
  userId               String        @unique
  personalInfoComplete Float         @default(0)
  educationComplete    Float         @default(0)
  workHistoryComplete  Float         @default(0)
  skillsComplete       Float         @default(0)
  totalComplete        Float         @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  bio                  String?       @db.Text
  education            Education[]
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills               Skill[]
  workHistory          WorkHistory[]
}

model Education {
  id          String    @id @default(cuid())
  degree      String
  institution String
  startDate   DateTime
  endDate     DateTime?
  profileId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId], map: "Education_profileId_fkey")
}

model WorkHistory {
  id          String    @id @default(cuid())
  jobTitle    String
  companyName String
  startDate   DateTime
  endDate     DateTime?
  description String?   @db.Text
  profileId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId], map: "WorkHistory_profileId_fkey")
}

model Skill {
  id        String   @id @default(cuid())
  name      String
  profileId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId], map: "Skill_profileId_fkey")
}

model DegreeList {
  id   String @id @default(cuid())
  name String @unique
}

model InstitutionList {
  id   String @id @default(cuid())
  name String @unique
}

model CompanyList {
  id   String @id @default(cuid())
  name String @unique
}

model SkillList {
  id   String @id @default(cuid())
  name String @unique
}
