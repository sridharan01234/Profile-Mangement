// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  username     String    @unique
  password     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  profile      Profile?
}

model Profile {
  id                    String       @id @default(cuid())
  // Personal Information (30%)
  address              String?
  phoneNumber          String?
  bio                  String?      @db.Text
  
  // Relations
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String       @unique
  education           Education[]
  workHistory         WorkHistory[]
  skills              Skill[]
  
  // Completion tracking
  personalInfoComplete    Float    @default(0)
  educationComplete      Float    @default(0)
  workHistoryComplete    Float    @default(0)
  skillsComplete         Float    @default(0)
  totalComplete          Float    @default(0)
  
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Education {
  id            String    @id @default(cuid())
  degree        String
  institution   String
  startDate     DateTime
  endDate       DateTime?
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model WorkHistory {
  id            String    @id @default(cuid())
  jobTitle      String
  companyName   String
  startDate     DateTime
  endDate       DateTime?
  description   String?   @db.Text
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Skill {
  id            String    @id @default(cuid())
  name          String
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Autocomplete support tables
model DegreeList {
  id     String @id @default(cuid())
  name   String @unique
}

model InstitutionList {
  id     String @id @default(cuid())
  name   String @unique
}

model CompanyList {
  id     String @id @default(cuid())
  name   String @unique
}

model SkillList {
  id     String @id @default(cuid())
  name   String @unique
}